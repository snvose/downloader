# ============================================================================
#  Downloader Bot — yapılandırma örneği
#  Bu dosyayı "data/.env" olarak kopyalayıp değerleri doldurun.
#  (install.sh kurulum sırasında bunu sizin için otomatik oluşturur.)
# ============================================================================

# ── ZORUNLU ──────────────────────────────────────────────────────────────────
# @BotFather'dan alınan bot token'ı
BOT_TOKEN="123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Bot yöneticisinin Telegram sayısal kullanıcı ID'si (@userinfobot ile öğrenin)
ADMIN_ID="123456789"

# ── GÖRÜNÜM ─────────────────────────────────────────────────────────────────
# Botun adı (start mesajında ve loglarda görünür)
BOT_NAME="Downloader"
# Bot kullanıcı adı (opsiyonel, @ olmadan)
BOT_USERNAME="botkullaniciadi"

# Start menüsünde owner/topluluk linkleri gösterilsin mi? (true/false)
SHOW_LINKS="true"
# SHOW_LINKS=true ise gösterilecek linkler:
OWNER_LINK="https://t.me/kullaniciadin"
COMMUNITY_LINK="https://t.me/kanaladin"
COMMUNITY_LABEL="Topluluk"

# ── İNDİRME / SINIRLAR ───────────────────────────────────────────────────────
# Aynı anda en fazla kaç indirme yapılabilir
MAX_SIMULTANEOUS_DOWNLOADS="3"
# Maksimum dosya boyutu (MB). Local Bot API kapalıyken Telegram limiti 50 MB'dir.
MAX_FILE_SIZE_MB="1900"

# ── LOCAL BOT API (opsiyonel) ────────────────────────────────────────────────
# 50 MB üstü dosya göndermek için kendi Local Bot API sunucunuzun adresi.
# Boş bırakılırsa normal Telegram Bot API kullanılır (50 MB sınırı).
# Örnek: http://127.0.0.1:8081
LOCAL_BOT_API_BASE=""
# Local Bot API çalıştırmak için gerekli (https://my.telegram.org'dan alınır)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# ── DOSYA YOLLARI ────────────────────────────────────────────────────────────
COOKIES_FILE="data/cookies.txt"
DOWNLOAD_DIR="data/downloads"
LOG_DIR="data/logs"

# ── BAKIM / TEMİZLİK ─────────────────────────────────────────────────────────
# downloads/ klasörünün otomatik temizleneceği saat ve saat dilimi.
# Varsayılan: her gün GMT-3 (Türkiye için -3 yerine 0 da kullanılabilir) 00:00.
CLEANUP_TZ_OFFSET="-3"
CLEANUP_HOUR="0"
# Günlük log dosyalarının kaç gün saklanacağı
LOG_RETENTION_DAYS="7"

# ── CACHE ────────────────────────────────────────────────────────────────────
# Aynı link tekrar gönderilince yeniden indirmeyi önleyen file_id cache (true/false)
CACHE_ENABLED="true"

# ── Faz 2: kaynak koruması ────────────────────────────────────────────────
JOB_TIMEOUT_SEC=1800
JOB_MAX_GB=4
LIVE_STRIKE_LIMIT=3
LIVE_BAN_DAYS=5

# ── Faz 2: cobalt (opsiyonel) ─────────────────────────────────────────────
# cobalt'ın herkese açık API'si YOK; kendi instance'ını çalıştırman gerekir.
# Boş bırakılırsa cobalt atlanır, bot yt-dlp ile normal çalışır.
# Kurulum + AGPL notu: docs/COBALT.md
COBALT_API_URL=
COBALT_API_KEY=
COBALT_TIMEOUT=30

# ── Faz 2: veritabanı ─────────────────────────────────────────────────────
DB_PATH=data/bot.db
