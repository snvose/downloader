# Downloader Bot configuration — copy this file to "data/.env" and fill in
# the values. (install.sh creates it for you automatically during setup.)

# ── Required ────────────────────────────────────────────────────────────────
BOT_TOKEN="123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ADMIN_ID="123456789"

# ── Appearance ──────────────────────────────────────────────────────────────
BOT_NAME="Downloader"
BOT_USERNAME=""

# Show owner/community links in the start menu? (true/false)
SHOW_LINKS="false"
OWNER_LINK="https://t.me/yourusername"
COMMUNITY_LINK="https://t.me/yourchannel"
COMMUNITY_LABEL="Community"

# ── Downloads / limits ────────────────────────────────────────────────────
MAX_SIMULTANEOUS_DOWNLOADS="3"
# Local Bot API off = the plain Telegram Bot API's 50 MB limit applies.
MAX_FILE_SIZE_MB="1900"

# ── Local Bot API (optional, for files over 50 MB) ───────────────────────
# Leave empty to use the regular Telegram Bot API (50 MB limit).
LOCAL_BOT_API_BASE=""
# Required to run a Local Bot API server (get these from https://my.telegram.org)
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# ── File paths ────────────────────────────────────────────────────────────
COOKIES_FILE="data/cookies.txt"
DOWNLOAD_DIR="data/downloads"
LOG_DIR="data/logs"

# ── Maintenance / cleanup ──────────────────────────────────────────────────
# Hour and UTC offset for the daily downloads/ cleanup. Default: 00:00 UTC.
CLEANUP_TZ_OFFSET="0"
CLEANUP_HOUR="0"
LOG_RETENTION_DAYS="7"

# Cookies are checked every hour. When a platform is logged out, expired or
# about to expire, one detailed report is sent to the admin at this hour
# (same UTC offset as above). A healthy day sends nothing.
COOKIE_REPORT_HOUR="11"

# Reuse file_id for a link sent again instead of re-downloading (true/false)
CACHE_ENABLED="true"

# ── Resource protection ────────────────────────────────────────────────────
JOB_TIMEOUT_SEC="1800"
JOB_MAX_GB="4"
LIVE_STRIKE_LIMIT="3"
LIVE_BAN_DAYS="5"

# ── cobalt (optional) ──────────────────────────────────────────────────────
# cobalt has no public API; you must run your own instance.
# Leave empty to skip cobalt — the bot runs normally on yt-dlp.
# Setup + AGPL note: docs/COBALT.md
COBALT_API_URL=
COBALT_API_KEY=
COBALT_TIMEOUT="30"

# ── Database ────────────────────────────────────────────────────────────────
DB_PATH="data/bot.db"
